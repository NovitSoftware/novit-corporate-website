# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling scratch
.commandcode/

# not part of the site, and not for a public repo: internal documents
# (brand, design system, sources), backups, and each developer's own agent
# and editor setup — `next dev` writes AGENTS.md and CLAUDE.md back on its own
/docs/
/backups/
/.claude/
AGENTS.md
CLAUDE.md

# the site installs with npm (package-lock.json); a second lockfile drifts
bun.lock
